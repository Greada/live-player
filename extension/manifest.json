{
  "manifest_version": 3,
  "name": "LivePlayer - PotPlayer 直播/视频助手",
  "version": "0.1.0",
  "description": "识别 B站 / 斗鱼 / 虎牙 直播间与 B站视频，点击用 PotPlayer 播放（4K 优先）。",
  "key": "",
  "permissions": ["nativeMessaging", "cookies", "contextMenus", "storage", "tabs"],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://*.douyu.com/*",
    "*://*.huya.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "用 PotPlayer 播放"
  },
  "options_page": "options.html",
  "icons": { "128": "icons/icon128.png" }
}
